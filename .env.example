# Node.js 24.21+ (24.x). No external services are required for local development.
HOST=127.0.0.1
PORT=3000
VOX_DB=data/vox.sqlite
NODE_ENV=development
# Optional camera capture. The delivered local .env enables it.
PHOTO_CAPTURE_ENABLED=false
# For production photographs, also configure:
# PHOTO_PRIVACY_APPROVED=true
# PHOTO_ENCRYPTION_KEY=INJECT_32_BYTE_BASE64_KEY_FROM_SECRET_MANAGER
# Production startup requires all three values, TLS, password rotation and review.
# LEGAL_REVIEW_APPROVED=true
# TRUST_PROXY=true
# PUBLIC_ORIGIN=https://vox.example.gov.br
# On Render, PUBLIC_ORIGIN defaults to RENDER_EXTERNAL_URL.
# For a new cloud database only (secret values supplied in the hosting dashboard):
# VOX_ADMIN_USERNAME=admregulacaodiretor
# VOX_UNIT_USERNAME=UBSMonterrey
# VOX_ADMIN_PASSWORD=SET_A_PRIVATE_INITIAL_PASSWORD
# VOX_UNIT_PASSWORD=SET_ANOTHER_PRIVATE_INITIAL_PASSWORD
# Optional backup directory. Defaults to 'backups' beside the active SQLite file.
# VOX_BACKUP_DIR=/var/data/backups
